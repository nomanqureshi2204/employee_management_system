package com.ems.client.service;

import java.time.LocalDate;
import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.ems.client.dto.ClientRequestDto;
import com.ems.client.dto.ClientResponseDto;
import com.ems.client.dto.ProjectResponseDto;
import com.ems.client.entity.Client;
import com.ems.client.exception.ClientAlreadyExistsException;
import com.ems.client.exception.ClientNotFoundException;
import com.ems.client.feign.ProjectFeign;
import com.ems.client.repository.ClientRepository;

@Service
public class ClientService {

    @Autowired
    private ClientRepository repository;
    
    @Autowired
    private ProjectFeign projectFeign;

    // CREATE CLIENT
   
    public ClientResponseDto createClient(ClientRequestDto dto) {

        // check duplicate email
        if (repository.existsByEmail(dto.getEmail())) {

            throw new ClientAlreadyExistsException(
                    "Client already exists with email: "
                            + dto.getEmail());
        }

        Client client = new Client();

        client.setClientId(generateClientId());
        client.setClientName(dto.getClientName());
        client.setEmail(dto.getEmail());

        // current date
        client.setRelationshipDate(LocalDate.now());

        client.setContacts(dto.getContacts());
        client.setProjectIds(dto.getProjectIds());

        Client saved = repository.save(client);

        return mapToResponse(saved);
    }

    // ============================================
    // GET ALL CLIENTS
    // ============================================
    public List<ClientResponseDto> getAllClients() {

        return repository.findAll()
                .stream()
                .map(this::mapToResponse)
                .collect(Collectors.toList());
    }

    // ============================================
    // GET CLIENT BY ID
    // ============================================
    public ClientResponseDto getClientById(String clientId) {

        Client client = repository.findByClientId(clientId)
                .orElseThrow(() ->
                        new ClientNotFoundException(
                                "Client not found: "
                                        + clientId));

        return mapToResponse(client);
    }

    // ============================================
    // UPDATE CLIENT
    // ============================================
    public ClientResponseDto updateClient(
            String clientId,
            ClientRequestDto dto) {

        Client client = repository.findByClientId(clientId)
                .orElseThrow(() ->
                        new ClientNotFoundException(
                                "Client not found: "
                                        + clientId));

        // update allowed fields only
        client.setClientName(dto.getClientName());
        client.setContacts(dto.getContacts());
        client.setProjectIds(dto.getProjectIds());
        client.setEmail(dto.getEmail());

        Client updated = repository.save(client);

        return mapToResponse(updated);
    }

    // ============================================
    // DELETE CLIENT
    // ============================================
    public String deleteClient(String clientId) {

        Client client = repository.findByClientId(clientId)
                .orElseThrow(() ->
                        new ClientNotFoundException(
                                "Client not found: "
                                        + clientId));

        repository.delete(client);

        return "Client deleted successfully";
    }
    
    public Boolean existsByClientId(String clientId) {
        return repository.existsByClientId(clientId);
    }
    
    // get projects by client-id 
    public List<ProjectResponseDto>getProjectByClientId(String clientId){
    	getClientById(clientId);
    	
    	return projectFeign.getProjectByClientId(clientId);
    }
    
    //get total no of clients 
    public long getTotalClients() {
        return repository.count();
    }
    

    // ============================================
    // CLIENT ID GENERATOR
    // ============================================
    private String generateClientId() {

        long count = repository.count() + 1;

        return String.format("client-%03d", count);
    }

    // ============================================
    // ENTITY -> DTO
    // ============================================
    private ClientResponseDto mapToResponse(Client c) {

        return new ClientResponseDto(
                c.getClientId(),
                c.getClientName(),
                c.getEmail(),
                c.getRelationshipDate(),
                c.getContacts(),
                c.getProjectIds()
        );
    }
}