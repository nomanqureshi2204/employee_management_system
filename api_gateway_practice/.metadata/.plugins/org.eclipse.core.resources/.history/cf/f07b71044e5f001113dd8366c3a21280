package com.ems.project.service;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.cloud.openfeign.clientconfig.Http2ClientFeignConfiguration;
import org.springframework.stereotype.Service;

import com.ems.project.dto.EmployeeResponseDto;
import com.ems.project.dto.ProjectRequestDto;
import com.ems.project.dto.ProjectResponseDto;
import com.ems.project.entity.Project;
import com.ems.project.exception.EmployeeNotFoundException;
import com.ems.project.exception.ProjectAlreadyExistsException;
import com.ems.project.exception.ProjectNotFoundException;
import com.ems.project.feign.ClientFeign;
import com.ems.project.feign.EmployeeFeign;
import com.ems.project.repository.ProjectRepository;

import feign.FeignException;

import org.springframework.cloud.openfeign.FeignClient;
@Service
public class ProjectService {

	@Autowired
	ProjectRepository repository;
	
	@Autowired
	private ClientFeign clientFeign;
	
	@Autowired
	private EmployeeFeign employeeFeign;

	// create project
	public ProjectResponseDto createProject(ProjectRequestDto dto) {
		
		// validate cleint exists(microservice call )
		if(!clientFeign.existsByClientId(dto.getClientId())) {
			throw new RuntimeException("client not found ");
		}
		
		
		//check duplicate project name 
		if(repository.existsByProjectName(dto.getProjectName())) {
			throw new ProjectAlreadyExistsException("Project already exists");
		}
		
		Project project = new Project();
		
		project.setProjectId(generatorProjectId());
		project.setProjectName(dto.getProjectName());
		project.setProjectStartDate(dto.getProjectStartDate());
		project.setProjectEndDate(dto.getProjectEndDate());
		project.setClientId(dto.getClientId());
		
		Project saved = repository.save(project);
		
		return mapToResponse(project);
		
	}
	
	// get all projects 
	public List<ProjectResponseDto>getAllProjects(){
		
		return repository.findAll()
				.stream().map(this::mapToResponse).collect(Collectors.toList());
	}
	
	// get project by id 
	public ProjectResponseDto getProjectById(String projectId) {
		
		Project project = repository.findByProjectId(projectId)
				.orElseThrow(()->new ProjectNotFoundException("Project not found "+projectId));
		
		return mapToResponse(project);
	}
	
	// delete project 
	public String deleteProject(String projectId) {
		
		Project project = repository.findByProjectId(projectId)
				.orElseThrow(()->new ProjectNotFoundException("Project not found"+projectId));
		
		repository.delete(project);
		
		return "Project deleted successfully";
	}
	
	 
	//update Project
	public ProjectResponseDto updateProject(String projectId,ProjectRequestDto dto) {
		
		Project project = repository.findByProjectId(projectId)
				.orElseThrow(()-> new ProjectNotFoundException("Project not found: "+projectId));
		
		project.setProjectName(dto.getProjectName());
		project.setProjectStartDate(dto.getProjectStartDate());
		project.setProjectEndDate(dto.getProjectEndDate());
		project.setClientId(dto.getClientId());
		
		Project updated = repository.save(project);
		
		return mapToResponse(updated);
	}
	
	//Get Employees By Project Id 
	public List<EmployeeResponseDto>
	getEmployeesByProjectId(String projectId){
		
		Project project = repository.findByProjectId(projectId)
				.orElseThrow(()-> new ProjectNotFoundException("Project not found"));
		
		 try {
		        return employeeFeign.getEmployeesByProjectId(projectId);
		    }
		    catch (FeignException.NotFound ex) {
		        throw new EmployeeNotFoundException(
		                "No employees found for project ID: " + projectId);
		    }
		
		
	}

	// id generator
	private String generatorProjectId() {
		
		String lastId = repository.findLastProjectId();
		
		int nextNumber = 1;
		
		if(lastId != null) {
			String number = lastId.replace("project-", "");
			nextNumber = Integer.parseInt(number)+1;
		}


		return String.format("project-%03d", nextNumber);
	}

	// entity -> dto
	private ProjectResponseDto mapToResponse(Project p) {

		return new ProjectResponseDto(p.getProjectId(), p.getProjectName(), p.getProjectStartDate(),
				p.getProjectEndDate(), p.getClientId());

	}
}
